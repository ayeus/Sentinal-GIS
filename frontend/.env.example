# Copy to .env.local (development) or .env.production (builds) and adjust.
# Every variable is optional; the defaults live in src/config.js.

# Backend URL. Leave unset to use http://127.0.0.1:8000 in development and
# same-origin relative URLs in production (unified single-host deployment).
# REACT_APP_API_BASE=https://your-sentinelgis-backend.onrender.com

# Only needed when the backend sets ADMIN_API_KEY. This value is embedded in
# the public bundle, so treat it as a soft gate, not a secret.
# REACT_APP_ADMIN_API_KEY=

# Disease pre-selected in the filters (default: all diseases)
# REACT_APP_DEFAULT_DISEASE=Dengue

# Live Intel polling interval in milliseconds
# REACT_APP_LIVE_REFRESH_MS=60000

# Map view
# REACT_APP_MAP_CENTER_LAT=22.9734
# REACT_APP_MAP_CENTER_LNG=78.6569
# REACT_APP_MAP_DISTRICT_ZOOM=4.7
# REACT_APP_MAP_STATE_ZOOM=5
# Optional background tiles behind the boundaries (none by default, so no API key is needed)
# REACT_APP_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# REACT_APP_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Boundary files and the property keys holding state / district names
# REACT_APP_DISTRICT_GEOJSON_URL=/india_districts.geojson
# REACT_APP_STATE_GEOJSON_URL=/data/india_states_full.geojson
# REACT_APP_GEO_STATE_KEY=NAME_1
# REACT_APP_GEO_DISTRICT_KEY=NAME_2
