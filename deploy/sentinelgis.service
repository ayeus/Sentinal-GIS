# Template: deploy/setup_vps.sh fills in the __PLACEHOLDERS__ and installs the
# result as /etc/systemd/system/sentinelgis.service. Do not copy this file as-is.
[Unit]
Description=SentinelGIS FastAPI Daemon & ML Ingestion Engine
After=network.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__INSTALL_DIR__/backend

# Environment variables (see backend/app/config.py for everything that can be set here)
Environment="PATH=__INSTALL_DIR__/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=__INSTALL_DIR__/backend"
Environment="PORT=__APP_PORT__"
Environment="HOST=127.0.0.1"
Environment="ENVIRONMENT=production"
Environment="ALLOWED_ORIGINS=__ALLOWED_ORIGINS__"
Environment="MAX_UPLOAD_MB=__MAX_UPLOAD_MB__"
# Optional overrides (e.g. ADMIN_API_KEY=...) without editing this unit
EnvironmentFile=-__INSTALL_DIR__/backend/.env

# Gunicorn process manager running high-performance Uvicorn workers.
# Logs go to stdout/stderr, i.e. journald: journalctl -u sentinelgis -f
ExecStart=__INSTALL_DIR__/backend/venv/bin/gunicorn \
    --workers __WORKERS__ \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:__APP_PORT__ \
    --timeout 180 \
    --access-logfile - \
    --error-logfile - \
    app.main:app

# Auto-restart on crash
Restart=always
RestartSec=5s

# Process limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
